# ---- Server ----
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://zirzir:zirzir@localhost:5432/zirzircord
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Seconds a dropped connection keeps its place before counting as "left"
PRESENCE_GRACE_SECONDS=30
MAX_UPLOAD_MB=100

# ---- Object storage (SeaweedFS locally, any S3 in production) ----
S3_ENDPOINT=http://localhost:9000
# URL that *clients* use to reach storage (presigned URLs are signed for it)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zirzircord
S3_ACCESS_KEY=zirzir
S3_SECRET_KEY=zirzirsecret
S3_FORCE_PATH_STYLE=true

# ---- LiveKit (self-hosted in docker-compose, or LiveKit Cloud) ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-0123456789abcdef
# IP that LiveKit advertises for media. Use your LAN IP to test from phones.
LIVEKIT_NODE_IP=127.0.0.1
