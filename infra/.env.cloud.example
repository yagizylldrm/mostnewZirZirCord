# Template only — copy to infra/.env.cloud (gitignored) and fill in from the dashboards.
# Never put real values in this file: it is committed to git.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432),
# with your database password filled in (URL-encode special characters).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Storage → S3 Configuration (enable "S3 protocol connection") → endpoint + region,
# then "New access key".
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_ACCESS_KEY=<access-key-id>
S3_SECRET_KEY=<secret-access-key>

# LiveKit Cloud → Settings → Keys (URL looks like wss://<project>.livekit.cloud)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=<api-key>
LIVEKIT_API_SECRET=<api-secret>

# Generate with: openssl rand -hex 48
JWT_SECRET=<long-random-string>

# Optional
# Website origins allowed to call the API (exact, comma separated). Default: the Vercel site + local dev + Tauri.
# CORS_ORIGINS=https://zirzircord.vercel.app,http://localhost:5173,http://localhost:14320
# deploy:api uses 'log' by default (older phone / Electron builds without the app header still work,
# offenders are logged). Switch to 'enforce' once everyone runs a build that sends the header.
# CLIENT_CHECK=log
