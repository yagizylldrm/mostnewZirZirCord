{
  "name": "@zirzircord/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/client": "~6.19.3",
    "@zirzircord/shared": "*",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "livekit-server-sdk": "^2.19.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prisma": "~6.19.3",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
