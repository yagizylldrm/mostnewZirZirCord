{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@zirzircord/shared": ["../../packages/shared/src/index.ts"],
      "@zirzircord/client-core": ["../../packages/client-core/src/index.ts"],
      "zustand": ["./node_modules/zustand"],
