{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZirZirCord",
  "version": "0.1.0",
  "identifier": "app.zirzircord.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @zirzircord/web",
    "beforeBuildCommand": "npm run build -w @zirzircord/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' data: blob: http: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss: blob: data:; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "zirzircord"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MTM5RUNFNzc0NDJGRTYKUldUbUwwUjN6cDRUcHBOSFZQUHlRaEFhTTZQSUZWRjljSXZwKzFYV1hLaWQ5TEtTcEg1SjVkVUIK",
      "endpoints": [
        "https://github.com/yagizylldrm/mostnewZirZirCord/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}